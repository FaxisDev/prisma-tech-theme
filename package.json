{
  "name": "prisma-tech-theme",
  "displayName": "Prisma-Tech",
  "description": "Tema oscuro prismático con panel visual para personalizar cada color en vivo: mezcla Aura y Material sobre un fondo #1B2126.",
  "version": "0.3.4",
  "publisher": "ArfaxadZadot",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1B2126",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FaxisDev/prisma-tech-theme"
  },
  "bugs": {
    "url": "https://github.com/FaxisDev/prisma-tech-theme/issues"
  },
  "homepage": "https://github.com/FaxisDev/prisma-tech-theme#readme",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "angular",
    "aura",
    "customizable",
    "dark",
    "green",
    "material",
    "prism",
    "prisma",
    "prismatic",
    "theme",
    "theme customizer"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "build": "node src/build.js"
  },
  "contributes": {
    "themes": [
      {
        "label": "Prisma-Tech",
        "uiTheme": "vs-dark",
        "path": "./themes/prisma-tech-color-theme.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "prismaTech",
          "title": "Prisma-Tech",
          "icon": "$(symbol-color)"
        }
      ]
    },
    "views": {
      "prismaTech": [
        {
          "type": "webview",
          "id": "prismaTech.customizerView",
          "name": "Personalizar tema"
        }
      ]
    },
    "commands": [
      {
        "command": "prismaTech.customize",
        "title": "Personalizar tema",
        "category": "Prisma-Tech"
      },
      {
        "command": "prismaTech.reset",
        "title": "Restablecer colores originales",
        "category": "Prisma-Tech"
      },
      {
        "command": "prismaTech.openSettings",
        "title": "Abrir ajustes del tema",
        "category": "Prisma-Tech"
      }
    ],
    "configuration": {
      "title": "Prisma-Tech",
      "properties": {
        "prismaTech.accentColor": {
          "type": "string",
          "default": "#61FFCA",
          "format": "color-hex",
          "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
          "order": 0,
          "markdownDescription": "Color de acento: cursor, pestaña activa, botones, barra de actividad y selección."
        },
        "prismaTech.background": {
          "type": "string",
          "default": "#1B2126",
          "format": "color-hex",
          "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
          "order": 1,
          "markdownDescription": "Fondo del editor. Los paneles, la barra lateral, los bordes y la terminal se calculan automáticamente a partir de este color."
        },
        "prismaTech.italicComments": {
          "type": "boolean",
          "default": true,
          "order": 2,
          "description": "Mostrar los comentarios en cursiva."
        },
        "prismaTech.italicKeywords": {
          "type": "boolean",
          "default": true,
          "order": 3,
          "description": "Mostrar en cursiva las keywords de control (import, export, return, if) y this/self."
        },
        "prismaTech.italicParameters": {
          "type": "boolean",
          "default": true,
          "order": 4,
          "description": "Mostrar los parámetros de funciones en cursiva."
        },
        "prismaTech.brightText": {
          "type": "boolean",
          "default": false,
          "order": 5,
          "description": "Texto más brillante y con más contraste en el editor y la interfaz."
        },
        "prismaTech.syntax": {
          "type": "object",
          "order": 6,
          "default": {},
          "additionalProperties": false,
          "markdownDescription": "Colores de sintaxis personalizados. Solo escribe los que quieras cambiar. Para editarlos de forma visual usa el comando **Prisma-Tech: Personalizar tema**.",
          "properties": {
            "comment": {
              "type": "string",
              "format": "color-hex",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "description": "Comentarios (por defecto #5C6B75)"
            },
            "string": {
              "type": "string",
              "format": "color-hex",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "description": "Strings (por defecto #CCFF4D)"
            },
            "keyword": {
              "type": "string",
              "format": "color-hex",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "description": "Keywords (if, return, import) (por defecto #ACA0FF)"
            },
            "storage": {
              "type": "string",
              "format": "color-hex",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "description": "Storage (const, class, function) (por defecto #C8B9FF)"
            },
            "function": {
              "type": "string",
              "format": "color-hex",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "description": "Funciones y métodos (por defecto #6E9CFF)"
            },
            "property": {
              "type": "string",
              "format": "color-hex",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "description": "Propiedades (por defecto #5CDFFF)"
            },
            "objectKey": {
              "type": "string",
              "format": "color-hex",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "description": "Claves de objetos literales, p. ej. { severity: 'error' } (por defecto #FF6EB6)"
            },
            "type": {
              "type": "string",
              "format": "color-hex",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "description": "Clases y tipos (por defecto #FFD21F)"
            },
            "classReference": {
              "type": "string",
              "format": "color-hex",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "description": "Clases usadas como valor, p. ej. en imports: [...] o new X (por defecto #C4EAFF)"
            },
            "injected": {
              "type": "string",
              "format": "color-hex",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "description": "Servicios inyectados como private readonly http: HttpClient (por defecto #9AD1FF)"
            },
            "parameter": {
              "type": "string",
              "format": "color-hex",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "description": "Parámetros (por defecto #C4EAFF)"
            },
            "number": {
              "type": "string",
              "format": "color-hex",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "description": "Números (por defecto #CCFF4D)"
            },
            "constant": {
              "type": "string",
              "format": "color-hex",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "description": "Constantes: null, undefined, enums (por defecto #F77BFF)"
            },
            "boolean": {
              "type": "string",
              "format": "color-hex",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "description": "Booleanos true / false (por defecto #3BA9F5)"
            },
            "constVariable": {
              "type": "string",
              "format": "color-hex",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "description": "Variables declaradas con const (por defecto #FF3B4E)"
            },
            "tag": {
              "type": "string",
              "format": "color-hex",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "description": "Tags HTML / JSX (por defecto #FF5370)"
            },
            "operator": {
              "type": "string",
              "format": "color-hex",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "description": "Operadores (por defecto #5ED3FF)"
            },
            "self": {
              "type": "string",
              "format": "color-hex",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "description": "this / self / super (por defecto #FFD21F)"
            }
          }
        },
        "prismaTech.titleGlow": {
          "type": "boolean",
          "default": true,
          "order": 7,
          "description": "Brillo animado (respiración) en el título del panel Personalizar tema. No afecta al tema."
        }
      }
    }
  }
}
