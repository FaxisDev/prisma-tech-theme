    "keybindingLabel.border": "#30353A",
    "keybindingLabel.bottomBorder": "#111418",
    "notifications.background": "#161A1E",
    "notifications.border": "#30353A",
    "notificationCenterHeader.background": "#121619",
    "notificationLink.foreground": "#61FFCA",
    "terminal.background": "#161A1E",
    "terminal.foreground": "#C5CED6",
    "terminalCursor.foreground": "#61FFCA",
    "terminal.selectionBackground": "#61FFCA33",
    "terminal.ansiBlack": "#121619",
    "terminal.ansiRed": "#FF6767",
    "terminal.ansiGreen": "#61FFCA",
    "terminal.ansiYellow": "#FFCA85",
    "terminal.ansiBlue": "#82AAFF",
    "terminal.ansiMagenta": "#A277FF",
    "terminal.ansiCyan": "#82E2FF",
    "terminal.ansiWhite": "#C5CED6",
    "terminal.ansiBrightBlack": "#5F666C",
    "terminal.ansiBrightRed": "#FF8D8D",
    "terminal.ansiBrightGreen": "#90FFDA",
    "terminal.ansiBrightYellow": "#FFCB6B",
    "terminal.ansiBrightBlue": "#A1BFFF",
    "terminal.ansiBrightMagenta": "#F694FF",
    "terminal.ansiBrightCyan": "#89DDFF",
    "terminal.ansiBrightWhite": "#FFFFFF",
