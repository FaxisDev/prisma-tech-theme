    "panelTitle.inactiveForeground": "#5F666C",
    "statusBar.background": "#161A1E",
    "statusBar.foreground": "#8A98A3",
    "statusBar.border": "#111418",
    "statusBar.debuggingBackground": "#A277FF",
    "statusBar.debuggingForeground": "#FFFFFF",
    "statusBar.noFolderBackground": "#161A1E",
    "statusBarItem.hoverBackground": "#242A2F",
    "statusBarItem.remoteBackground": "#61FFCA",
    "statusBarItem.remoteForeground": "#121619",
    "statusBarItem.prominentBackground": "#242A2F",
    "titleBar.activeBackground": "#161A1E",
    "titleBar.activeForeground": "#C5CED6",
    "titleBar.inactiveBackground": "#161A1E",
    "titleBar.inactiveForeground": "#5F666C",
    "titleBar.border": "#111418",
    "menu.background": "#161A1E",
    "menu.foreground": "#C5CED6",
    "menu.selectionBackground": "#61FFCA1F",
    "menu.selectionForeground": "#61FFCA",
    "menu.separatorBackground": "#30353A",
    "menu.border": "#30353A",
