      "settings": {
        "foreground": "#5CDFFF"
      }
    },
    {
      "scope": [
        "variable.other.object"
      ],
      "settings": {
        "foreground": "#DBF0F9"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml"
