    "editorHoverWidget.background": "#161A1E",
    "editorHoverWidget.border": "#30353A",
    "peekView.border": "#61FFCA",
    "peekViewEditor.background": "#161A1E",
    "peekViewResult.background": "#121619",
    "peekViewTitle.background": "#121619",
