        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.class.scss",
        "entity.other.attribute-name.class.less"
      ],
      "settings": {
        "foreground": "#4AEB9E"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#FFB86C"
      }
    },
    {
      "scope": [
        "variable.css",
        "variable.argument.css",
        "support.type.custom-property",
        "variable.scss",
        "variable.other.less"
      ],
      "settings": {
        "foreground": "#BEE4F4"
      }
    },
    {
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#5CDFFF"
      }
    },
    {
      "scope": [
        "support.constant.property-value.css",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#FF9A3C"
      }
    },
    {
      "scope": [
        "entity.name.tag.css",
        "entity.name.tag.scss",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css",
        "keyword.control.at-rule.css",
        "keyword.control.at-rule.scss",
        "keyword.control.at-rule.media.scss",
        "keyword.control.at-rule.include.scss",
        "keyword.control.at-rule.use.scss"
      ],
      "settings": {
        "foreground": "#C5BDFF"
      }
    },
    {
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#5CDFFF"
      }
    },
    {
      "scope": [
        "entity.name.decorator",
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#F77BFF",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.module"
      ],
      "settings": {
        "foreground": "#FFD23F"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.terminator",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#8FA8B6"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#61FFCA",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#FFA94D",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#F77BFF",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#FFA94D"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#5CDFFF"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#606E76",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.list",
        "punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#ACA0FF"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#61FFCA"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#FF4D5E"
      }
    },
    {
      "scope": [
