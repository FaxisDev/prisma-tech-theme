    "minimap.background": "#1B2126",
    "minimap.selectionHighlight": "#61FFCA55",
    "minimapSlider.background": "#5F666C22",
    "diffEditor.insertedTextBackground": "#61FFCA1A",
    "diffEditor.removedTextBackground": "#FF67671A",
    "panel.background": "#161A1E",
