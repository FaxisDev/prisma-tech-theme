    "quickInputList.focusBackground": "#61FFCA1F",
    "quickInputList.focusForeground": "#61FFCA",
    "pickerGroup.foreground": "#61FFCA",
    "pickerGroup.border": "#30353A",
    "keybindingLabel.background": "#242A2F",
